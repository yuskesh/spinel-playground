--- /dev/null
+++ b/doomgeneric/doomgeneric_e053.c
@@ -0,0 +1,257 @@
+//
+// doomgeneric_e053.c
+//
+// spinel-llvm / E053 (P004 Phase 4 後半) reference oracle hooks.
+//
+// Additive on top of the R007 headless harness and the E044 / E047 / E051 /
+// E052 dump hooks.  Same shape as all of them: one new .c file plus a handful
+// of #ifdef'd call sites, and a complete no-op unless DG_E053_DIR is set.
+//
+// E052 left 365 of 5 024 DEMO1 tics with a *pixel* difference in the 3D view
+// while every game-logic oracle matched.  Two suspects were named:
+//
+//   (a) R_DrawFuzzColumn -- fuzzpos is a file-scope static that persists across
+//       frames.  A single misplaced advance shifts the whole phase.
+//   (b) masked column clipping (mfloorclip / mceilingclip) at sprite edges.
+//
+// Both need the *sequence* of draw calls, not a snapshot, so this hook records
+// one line per call:
+//
+//   fuzz.tsv  gametic, seq, dc_x, yl_in, yh_in, yl, yh, count, pos_before,
+//             pos_after
+//   mcol.tsv  gametic, seq, source, dc_x, topdelta, length, yl_raw, yh_raw,
+//             floorclip, ceilingclip, yl, yh, drawn
+//
+// Nothing is re-implemented.  Every number is read out of the reference
+// implementation's own live state at the moment it is used.
+//
+// Environment variables:
+//
+//   DG_E053_DIR     output directory.  Unset -> the hook does nothing.
+//   DG_E053_WHAT    comma separated subset of "fuzz,mcol" (default: all)
+//   DG_E053_TIC_LO  first gametic to trace (default 0)
+//   DG_E053_TIC_HI  last gametic to trace, inclusive (default: no limit)
+//
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "doomtype.h"
+#include "doomdef.h"
+
+extern int gametic;
+
+// ------------------------------------------------------------------- state
+
+static int   s_on = 0;
+static int   s_init = 0;
+static char  s_dir[512];
+static int   s_want_fuzz = 1, s_want_mcol = 1;
+static int   s_lo = 0, s_hi = 0x7fffffff;
+static int   s_tics[64];
+static int   s_ntics = 0;
+
+static FILE *s_fuzz = NULL;
+static FILE *s_mcol = NULL;
+static FILE *s_span = NULL;
+static FILE *s_wcol = NULL;
+static FILE *s_stbar = NULL;
+static int   s_want_stbar = 1;
+static long  s_fuzz_seq = 0;
+static long  s_mcol_seq = 0;
+static long  s_span_seq = 0;
+static long  s_wcol_seq = 0;
+static int   s_want_span = 1, s_want_wcol = 1;
+
+static FILE *e053_open(const char *name, const char *hdr)
+{
+    char path[700];
+    FILE *fp;
+    snprintf(path, sizeof(path), "%s/%s", s_dir, name);
+    fp = fopen(path, "w");
+    if (fp == NULL)
+    {
+        fprintf(stderr, "E053: cannot write %s\n", path);
+        exit(1);
+    }
+    fputs(hdr, fp);
+    return fp;
+}
+
+static int e053_want(const char *what, const char *name)
+{
+    return what == NULL || strstr(what, name) != NULL;
+}
+
+static int e053_live(void)
+{
+    int i;
+    if (!s_on)
+        return 0;
+    if (s_ntics > 0)
+    {
+        for (i = 0; i < s_ntics; i++)
+            if (s_tics[i] == gametic)
+                return 1;
+        return 0;
+    }
+    return gametic >= s_lo && gametic <= s_hi;
+}
+
+void E053_Init(void)
+{
+    const char *dir, *what, *lo, *hi;
+
+    if (s_init)
+        return;
+    s_init = 1;
+
+    dir = getenv("DG_E053_DIR");
+    if (dir == NULL || dir[0] == '\0')
+        return;
+    snprintf(s_dir, sizeof(s_dir), "%s", dir);
+
+    what = getenv("DG_E053_WHAT");
+    s_want_fuzz = e053_want(what, "fuzz");
+    s_want_mcol = e053_want(what, "mcol");
+    s_want_span = e053_want(what, "span");
+    s_want_wcol = e053_want(what, "wcol");
+    s_want_stbar = e053_want(what, "stbar");
+
+    lo = getenv("DG_E053_TIC_LO");
+    hi = getenv("DG_E053_TIC_HI");
+    if (lo != NULL) s_lo = atoi(lo);
+    if (hi != NULL) s_hi = atoi(hi);
+    {
+        const char *tl = getenv("DG_E053_TICS");
+        if (tl != NULL && tl[0] != '\0')
+        {
+            const char *q = tl;
+            while (*q && s_ntics < 64)
+            {
+                s_tics[s_ntics++] = atoi(q);
+                while (*q && *q != ',') q++;
+                if (*q == ',') q++;
+            }
+        }
+    }
+
+    if (s_want_fuzz)
+        s_fuzz = e053_open("fuzz.tsv",
+                           "#gametic\tseq\tx\tyl_in\tyh_in\tyl\tyh\tcount\tpos_before\tpos_after\n");
+    if (s_want_mcol)
+        s_mcol = e053_open("mcol.tsv",
+                           "#gametic\tseq\tsrc\tx\ttopdelta\tlength\tyl_raw\tyh_raw\t"
+                           "floorclip\tceilingclip\tyl\tyh\tdrawn\n");
+    if (s_want_span)
+        s_span = e053_open("span.tsv",
+                           "#gametic\tseq\ty\tx1\tx2\tcmap\txfrac\tyfrac\txstep\tystep\tdistance\n");
+    if (s_want_wcol)
+        s_wcol = e053_open("wcol.tsv",
+                           "#gametic\tseq\tx\tyl\tyh\tcmap\tiscale\ttexturemid\tsrc0\twindow\n");
+    if (s_want_stbar)
+        s_stbar = e053_open("stbar.tsv",
+                            "#gametic\tfaceindex\tfacecount\toldhealth\trnd\thealth\t"
+                            "damagecount\tbonuscount\tattackdown\tkey0\tkey1\tkey2\n");
+    s_on = 1;
+}
+
+// Called from R_MapPlane once per span, after ds_colormap has been chosen.
+void E053_Span(int y, int x1, int x2, int cmap, int xfrac, int yfrac,
+               int xstep, int ystep, int distance)
+{
+    if (!e053_live() || s_span == NULL)
+        return;
+    fprintf(s_span, "%d\t%ld\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
+            gametic, s_span_seq++, y, x1, x2, cmap, xfrac, yfrac,
+            xstep, ystep, distance);
+}
+
+// The 128 bytes R_DrawColumn can reach through dc_source[(frac>>16)&127].
+static unsigned char s_wcol_src[128];
+
+void E053_WColSrc(const unsigned char *p)
+{
+    if (e053_live() && s_wcol != NULL)
+        memcpy(s_wcol_src, p, 128);
+}
+
+// Called from R_DrawColumn (the opaque one) before it writes anything.
+void E053_WCol(int x, int yl, int yh, int cmap, int iscale, int texturemid,
+               int src0)
+{
+    if (!e053_live() || s_wcol == NULL)
+        return;
+    {
+        char hex[257]; int i;
+        for (i = 0; i < 128; i++)
+            snprintf(hex + i * 2, 3, "%02x", s_wcol_src[i]);
+        fprintf(s_wcol, "%d\t%ld\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%s\n",
+                gametic, s_wcol_seq++, x, yl, yh, cmap, iscale, texturemid,
+                src0, hex);
+    }
+}
+
+// ------------------------------------------------------------------- hooks
+
+// Called from R_DrawFuzzColumn *after* the two border adjustments and the
+// count computation, before the early return.  yl_in / yh_in are the values
+// the caller passed in; yl / yh are the clamped ones the loop will use.
+void E053_Fuzz(int x, int yl_in, int yh_in, int yl, int yh, int count,
+               int pos_before, int pos_after)
+{
+    if (!e053_live() || s_fuzz == NULL)
+        return;
+    fprintf(s_fuzz, "%d\t%ld\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
+            gametic, s_fuzz_seq++, x, yl_in, yh_in, yl, yh, count,
+            pos_before, pos_after);
+}
+
+// Called from R_DrawMaskedColumn once per post, after clipping.
+// src: 0 = sprite (R_DrawVisSprite), 1 = masked seg (R_RenderMaskedSegRange),
+//      2 = player sprite (R_DrawPSprite).
+void E053_MCol(int src, int x, int topdelta, int length,
+               int yl_raw, int yh_raw, int floorclip, int ceilingclip,
+               int yl, int yh, int drawn)
+{
+    if (!e053_live() || s_mcol == NULL)
+        return;
+    fprintf(s_mcol, "%d\t%ld\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
+            gametic, s_mcol_seq++, src, x, topdelta, length,
+            yl_raw, yh_raw, floorclip, ceilingclip, yl, yh, drawn);
+}
+
+// R_DrawMaskedColumn does not know who called it; the three callers set this.
+static int s_mcol_src = 0;
+
+void E053_MColSrc(int src)
+{
+    s_mcol_src = src;
+}
+
+int E053_MColSrcGet(void)
+{
+    return s_mcol_src;
+}
+
+// Called at the end of ST_Ticker.
+void E053_StBar(int faceindex, int facecount, int oldhealth, int rnd,
+                int health, int damagecount, int bonuscount, int attackdown,
+                int k0, int k1, int k2)
+{
+    if (!e053_live() || s_stbar == NULL)
+        return;
+    fprintf(s_stbar, "%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
+            gametic, faceindex, facecount, oldhealth, rnd, health,
+            damagecount, bonuscount, attackdown, k0, k1, k2);
+}
+
+void E053_Flush(void)
+{
+    if (s_fuzz) fflush(s_fuzz);
+    if (s_mcol) fflush(s_mcol);
+    if (s_span) fflush(s_span);
+    if (s_wcol) fflush(s_wcol);
+    if (s_stbar) fflush(s_stbar);
+}
