core-contract 2
root app.rb
entry oob_dec
context thread
result none
param small buffer u8 inout count const 4
extern Adc.latest symbol spc_board_adc_latest arg ch u32 returns i32 isr_ok guard ch < 1 else bounds bound iterations 1 evidence e/adc.json
extern Telemetry.put symbol spc_channel_telemetry_put arg data buffer u8 in arg n u32 returns i32 isr_ok guard n >= 1 else argument guard n <= 16 else bounds guard n <= len(data) else bounds bound iterations 16 evidence e/put.json
extern Log.write symbol spc_log_write arg data buffer u8 in arg n u32 isr_ok bound iterations 64 evidence e/log.json
