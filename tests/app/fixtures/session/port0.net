# The network file the board lanes use by default (decision 0024): the
# board application's frames channel switched off (port 0), so the M33's
# network firmware takes its address by DHCP, publishes the boot id and then
# takes every message and discards it, counted. The destination is a
# documentation address (RFC 5737); a run that sends is given its own file,
# outside the repository, with NET=.
interface swp0
address dhcp
netmask dhcp
channel frames 192.0.2.1 0
