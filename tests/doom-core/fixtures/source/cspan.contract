param span buffer i32 in count n_span
param n_span scalar u64
param ycount buffer u8 inout count n_ycount
param n_ycount scalar u64
param yx1 buffer u16 inout count n_yx1
param n_yx1 scalar u64
param yx2 buffer u16 inout count n_yx2
param n_yx2 scalar u64
param height buffer u8 in count n_height
param n_height scalar u64
param i_nspan scalar i64
param i_span_max_kx scalar i64
param i_span_overlaps scalar i64
