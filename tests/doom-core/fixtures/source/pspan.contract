core-contract 1
root src/packed.rb
entry dc_sp_pspan
result i64
param state buffer i64 inout count n_state
param n_state scalar u64
param span buffer i32 inout count n_span
param n_span scalar u64
param sc_kind buffer u8 inout count n_sc_kind
param n_sc_kind scalar u64
param sc_idx buffer u16 inout count n_sc_idx
param n_sc_idx scalar u64
param cap_span buffer u16 in count n_cap_span
param n_cap_span scalar u64
param cap_sched buffer u16 in count n_cap_sched
param n_cap_sched scalar u64
param i_nspan scalar i64
param i_nsched scalar i64
param y scalar i64
param x1 scalar i64
param x2 scalar i64
param position scalar i64
param step scalar i64
param srcofs scalar i64
param cmap scalar i64
