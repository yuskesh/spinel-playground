core-contract 1
root src/packed.rb
entry dc_sp_ssclear
result i64
param state buffer i64 inout count n_state
param n_state scalar u64
param ss_first buffer i32 inout count n_ss_first
param n_ss_first scalar u64
param ss_last buffer i32 inout count n_ss_last
param n_ss_last scalar u64
param viewwidth buffer u16 in count n_viewwidth
param n_viewwidth scalar u64
param i_newend scalar i64
