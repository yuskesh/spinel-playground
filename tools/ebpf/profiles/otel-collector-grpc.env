# OpenTelemetry Collector — OTLP/gRPC (E261/E290、自前最小 HTTP/2 otlp_grpc.c)
# scheme が grpc:// なら gRPC transport を選択 (既定 port 4317)。
#   set -a; . profiles/otel-collector-grpc.env; set +a

OTEL_EXPORTER_OTLP_ENDPOINT=grpc://127.0.0.1:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# grpcs:// (TLS over gRPC) は ALPN h2 で ネゴシエート (E267)。CA は下記で。
# OTEL_EXPORTER_OTLP_ENDPOINT=grpcs://collector.example.com:4317
# OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/ssl/certs/ca-certificates.crt
