# ローカル/クラスタの OpenTelemetry Collector — OTLP/HTTP plaintext (E290)
# probe を Collector の otlp receiver (:4318) に送る。Collector 側で batch/enrich/変換/fan-out。
# logs を Splunk Platform に載せたい場合はこの経路 (Collector の splunk_hec exporter、E291)。
#   set -a; . profiles/otel-collector.env; set +a

# base endpoint。runtime が signal ごとに /v1/{traces,metrics,logs} を付ける (未設定時の後方互換、E290)。
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# 3 signal すべて同一 Collector へ (per-signal 上書きが要れば下記を有効化):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:4318/v1/logs
