# mTLS enterprise backend — 相互 TLS で OTLP/HTTP+protobuf 直送 (E268、ADR-013)
# 秘密 (client key) はファイルに焼かない。パスだけ指す。
#   set -a; . profiles/mtls.env; set +a

OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# サーバ証明書検証用 CA (未指定なら system CA)。
OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/ssl/certs/ca-certificates.crt

# client 証明書 (相互 TLS)。key は 0600 で置き、git に入れない。
OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=/etc/spinel/client.crt
OTEL_EXPORTER_OTLP_CLIENT_KEY=/etc/spinel/client.key

# 検証を切りたい検証環境のみ (本番では使わない):
# OTEL_EXPORTER_OTLP_INSECURE_SKIP_VERIFY=1
