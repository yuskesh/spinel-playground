# Splunk Observability Cloud (realm jp0) 直送 — OTLP/HTTP+protobuf over TLS (E290)
# 秘密は書かない: SPLUNK_TOKEN は別途 env で注入する。
#   set -a; . profiles/splunk-jp0.env; set +a
#   export SPLUNK_TOKEN=<your token>   # ファイルには焼かない

# traces は Splunk 専用 path /v2/trace/otlp (標準 /v1/traces は Splunk では 404)。
# 別 realm は jp0 を置き換える (例 us1 / eu0)。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://ingest.jp0.observability.splunkcloud.com/v2/trace/otlp

# 認証は X-SF-Token ヘッダ。値は env 参照に留める。
OTEL_EXPORTER_OTLP_HEADERS=X-SF-Token=${SPLUNK_TOKEN}

# protobuf (既定)。圧縮は任意。
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# TLS は system CA で公開証明書検証 (mbedTLS、ADR-013)。
# metrics は /v2/datapoint/otlp が endpoint 有だが OTLP ExponentialHistogram を拒否 (E291)。
# logs は Splunk O11y 直送不可 (E291) — logs は profiles/otel-collector.env 経由で Collector→HEC に。
