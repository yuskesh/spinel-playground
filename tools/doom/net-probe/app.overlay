/*
 * The probe's M33: its RAM is the DTCM (as tools/app/launcher's, after
 * boards/nxp/frdm_imxrt1186/cm33_sram_dtcm.overlay), and LPUART1 is its
 * console, since the M7 is not started.
 *
 * Locally administered unicast MAC addresses (decision 0024's amendment,
 * item 4): the board files' 00:00:00:... values lie in another
 * organisation's OUI. The second byte onwards keep the board files' pattern.
 */
/delete-node/ &dtcm;

/ {
	chosen {
		zephyr,sram = &dtcm;
	};

	soc {
		dtcm: memory@30000000 {
			compatible = "mmio-sram";
			reg = <0x30000000 DT_SIZE_K(128)>;
		};
	};
};

&enetc_psi1 {
	local-mac-address = [02 53 50 01 03 00];
};

&switch_port0 {
	local-mac-address = [02 53 50 01 05 00];
};

&switch_port2 {
	local-mac-address = [02 53 50 01 07 00];
};

&switch_port4 {
	local-mac-address = [02 53 50 01 08 00];
};
