def write_table(out, decl)
  # A declaration digest small enough to stay an immediate Integer on a 32-bit
  # target; the shim compares it with the one in npu.gen.rb.
  sig = (Digest::SHA256.hexdigest("#{decl.name}#{decl.input}#{decl.output}")[0, 7].to_i(16) | 1)
  ranks = [decl.input.size - 1, decl.output.size - 1].join
  File.write(File.join(out, "sp_tensor_table.h"), <<~C)
    /* Generated by tools/npu/spinel-npu -- do not edit. */
    #ifndef SP_TENSOR_TABLE_H_
    #define SP_TENSOR_TABLE_H_
    typedef struct {
      const char *name;
      const char *fq;
      int nscalar;
      int ntensor;
      int nin;
      int dest;
      int ret_scalar;
      const char *ranks;
      const char *dtypes;
      const char *shape;
      long long sig;
    } sp_t_entry_t;
    static const sp_t_entry_t SP_T_TABLE[] = {
      {"#{decl.name}", "npu.#{decl.name}", 0, 2, 1, 1, 0, "#{ranks}", "33", "", #{sig}LL},
    };
    #define SP_T_TABLE_N 1
    #endif
  C
  sig
end

def write_gen(rb, decl, sig)
  File.write(File.join(rb, "npu.gen.rb"), <<~RUBY)
    # Generated by tools/npu/spinel-npu -- do not edit.
    def #{decl.name}(x, y)
      rc = SPT.sp_t_invoke("#{decl.name}", #{sig}, 0.0, x.handle, y.handle, 0, 0, y.length)
      if rc != 0
        raise TensorError, "#{decl.name}: \#{SPT.sp_t_last_error}"
      end
      y
    end
  RUBY
end

# The IREE side both boards share: the module and a device with only our executable.
def device_glue(vmfb)
  <<~C
    static const unsigned char vmfb[] __attribute__((aligned(64))) = {#{vmfb.unpack("C*").join(",")}};

    __attribute__((constructor)) static void npu_register(void)
    {
    \tsp_t_register_module("npu", vmfb, sizeof(vmfb));
    }

    iree_status_t sp_t_static_device(const char *uri, iree_allocator_t a, iree_hal_device_t **out)
    {
    \tif (strcmp(uri, "local-sync") != 0) {
    \t\treturn iree_make_status(IREE_STATUS_NOT_FOUND, "only local-sync exists here");
    \t}
    \tiree_hal_sync_device_params_t p;
    \tiree_hal_sync_device_params_initialize(&p);
    \tconst iree_hal_executable_library_query_fn_t libs[] = {e_library_query};
    \tiree_hal_executable_loader_t *l = NULL;
    \tiree_status_t s = iree_hal_static_library_loader_create(1, libs, iree_hal_executable_import_provider_null(), a, &l);
    \tiree_string_view_t id = iree_make_cstring_view("local-sync");
    \tiree_hal_allocator_t *da = NULL;

    \tif (iree_status_is_ok(s)) s = iree_hal_allocator_create_heap(id, a, a, &da);
    \tif (iree_status_is_ok(s)) s = iree_hal_sync_device_create(id, &p, 1, &l, da, a, out);
    \tiree_hal_allocator_release(da);
    \tiree_hal_executable_loader_release(l);
    \treturn s;
    }
  C
end

def write_glue(out, m, vmfb, tag)
  File.write(File.join(out, "npu_glue.c"), <<~C)
    /* Generated by tools/npu/spinel-npu -- do not edit. */
    #include <zephyr/kernel.h>
    #include <zephyr/sys/printk.h>
    #include <string.h>
    #include "NeutronDriver.h"
    #include "iree/hal/drivers/local_sync/sync_device.h"
    #include "iree/hal/local/loaders/static_library_loader.h"
    #include "iree/runtime/api.h"
    #include "npu_k.h"

    extern const uint8_t npu_microcode[], npu_weights[], npu_kernels[];
    int sp_t_register_module(const char *, const void *, int64_t);
    bool tiny_wait_until(int64_t deadline_ns) { return true; }

    static __aligned(16) uint8_t ctx_mem[2048];
    static __aligned(16) uint8_t scratch[#{m[:scratch].shape[0]}];
    static uint8_t empty[16];
    static NeutronModelHandle handle;
    /* The driver keeps this pointer past neutronModelPrepare. */
    static const NeutronModelConfig model = {.microcode = npu_microcode, .weights = npu_weights, .kernels = npu_kernels};

    /* The dispatch has no error path into IREE; a driver error stops the program. */
    static void npu_die(const char *what, NeutronError e)
    {
    \tprintk("spinel-npu: %s failed: %x\\n", what, e);
    \tk_panic();
    }

    void sp_npu_run(const int8_t *in, uint32_t in_off, int8_t *out, uint32_t out_off)
    {
    \tif (!handle) {
    \t\tprintk("spinel-npu: build #{tag}\\n");
    \t\tNeutronError e = neutronInit();
    \t\tNeutronModelHandle h = (NeutronModelHandle)ctx_mem;

    \t\tif (neutronGetModelContextSize() > sizeof(ctx_mem)) npu_die("context size", 0);
    \t\tif (e != ENONE) npu_die("neutronInit", e);
    \t\tif ((e = neutronModelPrepare(&model, &h)) != ENONE) npu_die("neutronModelPrepare", e);
    \t\thandle = h;
    \t}
    \tconst void *i[1] = {in + in_off};
    \tvoid *o[4] = {out + out_off, scratch, empty, scratch};
    \tNeutronDataConfig d = {.inputs = i, .outputs = o, .scratch = scratch, .scratchWeights = NULL};
    \tNeutronError e = neutronRunBlocking(handle, &d);

    \tif (e != ENONE) npu_die("neutronRunBlocking", e);
    }

    #{device_glue(vmfb)}
  C
end

# ---- the workspace and the build -------------------------------------------
def check_workspace(ws)
  p = pins
  describe = run!("git", "-C", File.join(ws, "zephyr"), "describe", "--tags").strip
  die("#{ws}/zephyr is #{describe}, the table pins #{p["zephyr_describe"]}", 2) unless describe == p["zephyr_describe"]
  hal = run!("git", "-C", File.join(ws, "modules/hal/nxp"), "rev-parse", "HEAD").strip
  die("hal_nxp is #{hal}, the table pins #{p["hal_nxp_revision"]}", 2) unless hal == p["hal_nxp_revision"]
  { "libNeutronDriver.a" => "blob_driver_sha256", "libNeutronFirmware.a" => "blob_firmware_sha256" }.each do |f, key|
    path = File.join(ws, "modules/hal/nxp/zephyr/blobs/neutron/mcxn", f)
    die("#{path} is missing: west blobs fetch hal_nxp", 2) unless File.exist?(path)
    die("#{path} differs from the table", 2) unless Digest::SHA256.file(path).hexdigest == p[key]
  end
  sdk = File.read(File.join(env!("ZEPHYR_SDK_INSTALL_DIR"), "sdk_version")).strip
  die("the Zephyr SDK is #{sdk}, the table pins #{p["zephyr_sdk"]}", 2) unless sdk == p["zephyr_sdk"]
end

M33 = %w[-mcpu=cortex-m33 -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 -Os -ffunction-sections -fdata-sections -std=gnu2x -w].freeze
# One flags array for the runtime and the generated code (a define that reaches
# only one side links and is silently wrong). The GC tables fall back safely
# when full: minor collections become full ones, or the table grows on the heap.
# SP_ALLOC_STATS and SP_STR_SHAPE_MAX size diagnostic tables; 1 keeps them out of RAM.
RT_DEFS = %w[-DSP_NO_SIGNALS -DSP_MAX_WORKERS=1 -D__wasi__ -D_GNU_SOURCE
             -DSP_ALLOC_STATS=1 -DSP_STR_SHAPE_MAX=1 -DSP_GC_STACK_MAX=256 -DSP_GC_REMEMBERED_MAX=1024
             -DSP_GC_MARK_STACK_MAX=256 -DSP_GC_PINNED_MAX=256 -DSP_DYN_SYMS_MAX=256].freeze
RT_INC = ["-I#{VENDOR}/lib", "-I#{VENDOR}/lib/regexp", "-I#{VENDOR}/lib/regexp/shim", "-isystem", "#{HOST}/shim",
          "-include", "#{HOST}/force.h"].freeze
IREE_DEFS = %w[-DIREE_PLATFORM_GENERIC=1 -DIREE_FILE_IO_ENABLE=0 -DIREE_DEVICE_SIZE_T=uint32_t -DPRIdsz=PRIu32
               -DIREE_STATUS_MODE=0 -DIREE_ALLOCATOR_SYSTEM_CTL=iree_allocator_libc_ctl -DSP_T_STATIC_DEVICE].freeze

def build(decl, out, rb, stripped, app)
  ws = env!("ZEPHYR_WORKSPACE")
  sdk = env!("ZEPHYR_SDK_INSTALL_DIR")
  src = env!("IREE_SRC")
  m33 = env!("IREE_M33_BUILD")
  gcc = "#{sdk}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc"

  Dir[File.join(File.dirname(app), "*.rb")].each { |f| FileUtils.cp(f, rb) }
  File.write(File.join(rb, File.basename(app)), stripped)
  FileUtils.cp_r(File.join(ROOT, "tools/tensor/spinel"), rb)

  mk = File.read(File.join(VENDOR, "Makefile"))
  members = mk[/^RT_MEMBERS\s*=\s*(.+)$/, 1].to_s.split
  regexp = mk[/^RE_SRC\s*=\s*(.+)$/, 1].to_s.split
  die("no RT_MEMBERS or RE_SRC in the vendor Makefile") if members.empty? || regexp.empty?
  rt = File.join(out, "rt")
  FileUtils.mkdir_p(rt)
  (members.map { |m| "lib/#{m}.c" } + regexp).each do |s|
    obj = File.join(rt, "#{File.basename(s, ".c")}.o")
    next if File.exist?(obj)
    run!(gcc, *M33, *RT_DEFS, *RT_INC, "-c", File.join(VENDOR, s), "-o", obj)
  end

  spinel = File.join(VENDOR, "bin/spinel")
  die("no #{spinel}: build vendor/spinel first", 2) unless File.executable?(spinel)
  run!(spinel, File.basename(app), "-c", "-o", File.join(out, "app.c"), chdir: rb, log: File.join(out, "spinel.log"))
  iree_inc = ["-I#{src}/runtime/src", "-I#{src}", "-I#{m33}/runtime/src", "-I#{out}"]
  run!(gcc, *M33, *RT_DEFS, *RT_INC, *IREE_DEFS, *iree_inc, "-Dmain=sp_app_main", "-c", File.join(out, "app.c"), "-o", File.join(out, "app.o"))
  run!(gcc, *M33, *RT_DEFS, *RT_INC, *IREE_DEFS, *iree_inc, "-c", File.join(ROOT, "tools/tensor/sp_tensor_shim.c"), "-o", File.join(out, "shim.o"))

  west = File.join(ws, ".venv/bin/west")
  west = "west" unless File.executable?(west)
  env = { "ZEPHYR_BASE" => File.join(ws, "zephyr"), "CMAKE_EXPORT_NO_PACKAGE_REGISTRY" => "ON" }
  run!(west, "build", "-p", "always", "-b", BOARD, "-d", File.join(out, "zephyr"), HOST, "--",
       "-DSP_NPU_OUT=#{out}", "-DCMAKE_EXPORT_NO_PACKAGE_REGISTRY=ON",
       env: env, chdir: ws, log: File.join(out, "zephyr.log"))
end

# ---- main ------------------------------------------------------------------
args = ARGV.dup
bi = args.index("--board")
board = bi ? args[bi + 1] : "frdm-mcxn947"
args.slice!(bi, 2) if bi
die("--board is frdm-mcxn947 or stm32mp257f-dk; got #{board.inspect}", 2) unless %w[frdm-mcxn947 stm32mp257f-dk].include?(board)
check_only = !args.delete("--check-only").nil?
oi = args.index("-o")
die("usage: spinel-npu [--board NAME] app.rb -o OUT [--check-only]", 2) unless oi && args[oi + 1]
out = File.expand_path(args[oi + 1])
args.slice!(oi, 2)
die("usage: spinel-npu [--board NAME] app.rb -o OUT [--check-only]", 2) unless args.size == 1
app = File.expand_path(args[0])
die("#{app}: no such file", 2) unless File.exist?(app)

decl, stripped = parse(app)
guard_out(out)
FileUtils.mkdir_p(out)
File.write(File.join(out, "program.rb"), stripped)
if decl.model
  path = File.join(out, "generated.tflite")
  File.binwrite(path, decl.model)
else
  path = File.expand_path(decl.tflite, File.dirname(app))
  die("#{path}: no such model", 2) unless File.exist?(path)
end
if board == "stm32mp257f-dk"
  stm32_lane(decl, path, out, stripped, app, check_only)
  exit 0
end
converted, model = convert(path, out)
m = check_model(decl, model, converted)
puts "spinel-npu: #{decl.name}: 1 NeutronGraph, input #{shape_s(m[:input])}, output #{shape_s(m[:output])}"
exit 0 if check_only

check_workspace(env!("ZEPHYR_WORKSPACE"))
rb = File.join(out, "rb")
FileUtils.mkdir_p(rb)
write_model(out, model, m)
File.write(File.join(out, "npu.mlir"), mlir(decl))
run!(env!("IREE_COMPILE"), File.join(out, "npu.mlir"), *IREE_M33,
     "--iree-llvmcpu-static-library-output-path=#{File.join(out, "npu_k.h")}", "-o", File.join(out, "npu.vmfb"))
sig = write_table(out, decl)
write_gen(rb, decl, sig)
vmfb = File.binread(File.join(out, "npu.vmfb"))
# Printed by the image, so a console capture can be tied to this program and model.
tag = Digest::SHA256.hexdigest(vmfb + stripped + File.binread(File.join(out, "npu_model.c")))
File.write(File.join(out, "build.tag"), "#{tag}\n")
write_glue(out, m, vmfb, tag)
build(decl, out, rb, stripped, app)
puts "spinel-npu: #{File.join(out, "zephyr/zephyr/zephyr.bin")}"
