			printk("SPC_STACK name=<%= t[:name] %> used=%u size=%u\n", (unsigned)aused, (unsigned)asize);
		}
<% end %>		printk("SPC_STACK name=interrupt used=%u size=%u\n", (unsigned)iused, (unsigned)isize);
