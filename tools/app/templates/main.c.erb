/* generated from tools/app/templates/main.c.erb by spinel-core-app build: the
 * glue of decision 0014 §4 and §8 for `<%= app_name %>` on <%= board %>.
 *
 * Storage: one static buffer per `state`, aligned to its element, zero at
 * start (§10). Entry wrappers: spc_entry_<name>() passes the entry's states
 * to the kernel's object. The scheduler thread sweeps the thread entries in
 * declaration order with a fresh clock reading per entry and sleeps until
 * the earliest next release; each interrupt entry has a k_timer whose expiry
 * runs the selection rule for every interrupt entry, in the system clock
 * interrupt. The clock is k_cycle_get_64() (§4). The failure handler records
 * the entry, status and release, stops every entry of that context and puts
 * the devices that context owns into their safe state (§4).
 *
 * Compiled with the kernel's clang against Zephyr's headers and measured by
 * the same method as the CORE objects (§8 step 8); linked by west. Every
 * arithmetic on 64-bit cycle counts avoids a libgcc division helper: the
 * release arithmetic uses a bounded shift-subtract division (spc_udiv64).
 *
 * A verification build (SPC_VERIFY, §10) records every selection with its
 * clock reading, every invocation's start, status, private state and end,
 * every failure with the cancellations it causes, the cuts at the horizon
 * H, and runs the end sequence: once every context has ended every
 * invocation it started, the transport thread drains the outbound queues
 * and the recorder's rings and writes the end marker (transport_uart.c);
 * after D past H an incomplete trace says so. Each actor sets the recorder's
 * current context and entry around its recorded work and restores them, so
 * a preempting actor leaves the preempted one's values as they were. The
 * per-entry cycle figures of the plan's D3 item are printed after the end
 * marker as SPC_CYCLES lines: the count is k_cycle_get_64() around the
 * invocation, and around each __aeabi_ldivmod call through the linker's
 * --wrap (cycles.c), so the wrapper's own cycles are inside the figure.
 */
#include <stdint.h>
#include <string.h>
#include <zephyr/kernel.h>
#include <zephyr/sys/printk.h>
<% bell = pair && pair[:doorbell] %><% if bell %>#include <zephyr/drivers/mbox.h>
<% end %><% if pair %>#include <zephyr/init.h>
#include <cmsis_core.h>
#include "ring/ring_abi.h"
#include "ring/cycles.h"
#include "ring/wait_map.h"
<% end %><% board_modules.each do |m| %>#include "adapters/<%= m[:class_dir] %>/adapter.h"
<% end %>
<% app.channels.each do |c| %>#include "channel_<%= c.name %>.h"
<% end %>
#ifndef SPC_SCHEDULER_STACK
#define SPC_SCHEDULER_STACK 2048
#endif
#define SPC_CYC_PER_SEC <%= cycles_per_sec %>u
<% if stress %>void spc_stress_timer_start(void); /* 0014 Task 12's sampling source, a production build's */
<% end %><% if pcsample %>void spc_pcsample_timer_start(void); /* the PC sampler of a measurement build (--pcsample) */
<% end %><% if verification %>#define SPC_VERIFY 1
#include "recorder.h"
#define SPC_CTX_SCHED 0u
#define SPC_CTX_TIMER <%= timer_ctx %>u /* 3 + the system timer's index in the inventory */
#define SPC_HORIZON_CYC ((uint64_t)<%= horizon_us %>u * (SPC_CYC_PER_SEC / 1000000u))
#define SPC_DRAIN_CYC ((uint64_t)<%= drain_us %>u * (SPC_CYC_PER_SEC / 1000000u))
extern volatile uint8_t spc_end_requested, spc_ended, spc_end_timed_out; /* transport_uart.c */
void spc_rec_register_state(uint8_t id, const void *base, uint32_t count, uint8_t width);
uint32_t spc_rec_sequence(void);
extern uint32_t spc_rec_dropped, spc_rec_unregistered;
extern uint32_t spc_transport_passes;
uint32_t spc_transport_stack_mark(uint32_t *size); /* transport_uart.c */
<% adapter_threads.each do |t| %>uint32_t spc_adapter_<%= t[:cls] %>_stack_mark(uint32_t *size); /* adapters/<%= t[:cls] %>: the <%= t[:name] %> thread */
<% end %>/* the interrupt stack's high-water mark: CONFIG_INIT_STACKS painted it 0xAA at boot */
extern K_KERNEL_STACK_ARRAY_DECLARE(z_interrupt_stacks, CONFIG_MP_MAX_NUM_CPUS, CONFIG_ISR_STACK_SIZE);
static uint32_t spc_isr_stack_mark(uint32_t *size)
{
	const uint8_t *base = (const uint8_t *)K_KERNEL_STACK_BUFFER(z_interrupt_stacks[0]);
	uint32_t n = K_KERNEL_STACK_SIZEOF(z_interrupt_stacks[0]);
	uint32_t unused = 0;

	while (unused < n && base[unused] == 0xAAu) {
		unused++;
	}
	*size = n;
	return n - unused;
}
void spc_stimulus_start(uint64_t epoch);
<% if nest_timer %>void spc_nest_timer_start(uint64_t epoch);
void spc_nest_timer_stop(void);
<% end %>static volatile uint8_t spc_isr_cut_done; /* the timer dispatch wrote its cuts at H */
/* the D3 figures, per entry: invocations, cycles inside them, and inside __aeabi_ldivmod */
uint32_t spc_cyc_calls[<%= app.scheduled.size %>];
uint64_t spc_cyc_total[<%= app.scheduled.size %>];
uint32_t spc_cyc_ldivmod_calls[<%= app.scheduled.size %>];
uint64_t spc_cyc_ldivmod[<%= app.scheduled.size %>];
<% end %>
/* ---- the failure record and the stopped contexts (§4) */
volatile int32_t spc_failed_status;
volatile uint32_t spc_failed_entry;
volatile uint32_t spc_failed_release;
volatile uint8_t spc_context_stopped[2]; /* [0] thread, [1] interrupt */
<% if failure_sites %>
/* ---- failure sites (spinel-core-app --failure-sites, a debugging aid): the
 * first failed call's entry, status and site (spinel-core-kernel's table in
 * the firmware's sites/), recorded by the failing path and printed once by
 * main at the lowest priority */
<% failure_sites.each do |e| %>extern int32_t spinel_core_<%= e %>_failure_site;
<% end %>const char *volatile spc_fs_entry;
volatile int32_t spc_fs_status;
volatile int32_t spc_fs_site;
static int32_t *const spc_fs_sites[<%= app.scheduled.size %>] = { <%= app.scheduled.map { |e, _| "&spinel_core_#{e.name}_failure_site" }.join(', ') %> };
<% end %>

/* ---- storage (§10: all zero at start) */
<% app.states.each do |st| %><% if st.placement == :session && session[:dtcm].to_a.include?(st.name) %>/* <%= st.name %>: the session's, kept in the data TCM (core_session dtcm:, filled at boot) */
extern uint8_t spc_dtcm_<%= st.name %>[];
#define spc_state_<%= st.name %> ((<%= ctype[st.element] %> *)spc_dtcm_<%= st.name %>)
<% elsif st.placement == :session %>/* <%= st.name %>: the session's (decision 0021), <%= st.part == "resource" ? "read in place from the NOR" : "in the writable part copied at boot" %> */
#define spc_state_<%= st.name %> ((<%= ctype[st.element] %> *)<%= st.part == "resource" ? "(uintptr_t)#{format('0x%08xu', session[:base] + st.offset)}" : "(spc_session_rw + #{st.offset}u)" %>)
<% else %>static <%= ctype[st.element] %> spc_state_<%= st.name %>[<%= st.count %>] __attribute__((aligned(<%= width[st.element] %>)));
<% end %><% end %><% if session %>/* the session: its writable part, and the check and copy that run before
 * any entry (decision 0021) */
extern uint8_t spc_session_rw[];
extern const char spc_session_id[];
int32_t spc_session_load(void);
<% end %>
<% app.scratches.each do |ctx, bytes| %>/* the <%= ctx %> context's data stack (decision 0041 stage 2): the first word
 * is the bump offset, zero at start; the arrays follow it */
static uint8_t spc_scratch_<%= ctx %>[<%= bytes %>] __attribute__((aligned(8)));
<% end %>/* ---- the entries, the kernel's objects */
<% app.scheduled.each do |entry, trig| %>int32_t spinel_core_<%= entry.name %>(<%= (entry.params.map { |p| "#{ctype[app.state(p).element]} *#{p}" } + (app.scratches[trig.context] ? ["void *scratch"] : [])).join(", ") %>);
<% end %>
/* ---- the transport (Task 8) */
<% app.channels.select(&:xcore).each do |c| %>int32_t spc_channel_<%= c.name %>_check(void);
<% end %><% if app.channels.any?(&:framed?) || verification %>void spc_transport_start(void);
<% end %>
/* ---- board package init and safe states */
<% board_modules.each do |m| %><% if m[:init] %>int32_t spc_board_<%= m[:stem] %>_init(void);
<% end %><% end %>
<% owned.each do |ctx, list| %><% list.each do |mod, idx, stem, cls| %>extern const <%= mod[:table] %> spc_board_<%= stem %>_table[];
<% end %><% end %>

/* 64 / 32 division without libgcc: 64 shift-subtract steps, always. */
static uint64_t spc_udiv64(uint64_t n, uint32_t d)
{
	uint64_t q = 0, r = 0;

	for (int i = 63; i >= 0; i--) {
		r = (r << 1) | ((n >> i) & 1u);
		q <<= 1;
		if (r >= d) {
			r -= d;
			q |= 1u;
		}
	}
	return q;
}

/* ---- the entry wrappers */
<% app.scheduled.each_with_index do |(entry, trig), i| %>static int32_t spc_entry_<%= entry.name %>(void)
{
	return spinel_core_<%= entry.name %>(<%= (entry.params.map { |p| "spc_state_#{p}" } + (app.scratches[trig.context] ? ["spc_scratch_#{trig.context}"] : [])).join(", ") %>);
}
<% end %>
/* ---- the entry table: index, name, context, period in cycles, wrapper */
struct spc_entry {
	const char *name;
	uint8_t context; /* 0 thread, 1 interrupt */
	uint64_t period_cyc;
	int32_t (*run)(void);
	uint64_t last_run; /* releases since the epoch: 64-bit, like the clock, so it never wraps */
#if defined(SPC_VERIFY)
	uint64_t last_classified; /* the last release with a terminal class (§10) */
#endif
};
static struct spc_entry spc_entries[] = {
<% app.scheduled.each do |entry, trig| %>	{ "<%= entry.name %>", <%= trig.context == "thread" ? 0 : 1 %>, (uint64_t)<%= trig.period_us %>u * (SPC_CYC_PER_SEC / 1000000u), spc_entry_<%= entry.name %>, 0u
#if defined(SPC_VERIFY)
	  , 0u
#endif
	},
<% end %>};
#define SPC_ENTRIES <%= app.scheduled.size %>u
static uint64_t spc_epoch;
<% if bell %>
/* ---- the doorbell (decision 0028): the MU's general-purpose interrupt of
 * <%= bell[:channels].map { |d| "channel #{d[:name]} (GIR#{d[:gi]})" }.join(', ') %>, on <%= bell[:label] %>, through Zephyr's MU
 * driver, whose handler clears GIPn and calls spc_doorbell. It counts the
 * wake-up in the channel's line C (woken), marks each entry the channel
 * wakes due, and gives spc_wake_sem, which the scheduler thread takes in
 * place of its sleep: a doorbell that comes while the entries run is kept
 * by the semaphore, not lost. A due entry runs before its period; its
 * periodic releases are unchanged and are the time-out of a doorbell that
 * never comes. */
K_SEM_DEFINE(spc_wake_sem, 0, 1);
static volatile uint8_t spc_due[SPC_ENTRIES];
<% bell[:channels].each do |d| %>static uint32_t spc_woken_<%= d[:name] %>;
<% end %>
static void spc_doorbell(const struct device *dev, mbox_channel_id_t channel, void *user_data, struct mbox_msg *data)
{
	volatile uint32_t *w = (volatile uint32_t *)<%= pair[:role] == :companion ? 'SPC_RING_M33_BASE' : 'SPC_RING_M7_BASE' %>;

	(void)dev;
	(void)user_data;
	if (data != NULL) {
		return; /* a data message, not a doorbell */
	}
<% bell[:channels].each do |d| %>	if (channel == <%= d[:gi] %>u) {
		spc_woken_<%= d[:name] %>++;
		spc_ring_store(w, SPC_CH_C(<%= d[:index] %>u) + SPC_CH_C_WOKEN, spc_woken_<%= d[:name] %>);
<% d[:entries].each do |ei| %>		spc_due[<%= ei %>u] = 1u; /* <%= app.scheduled[ei][0].name %> */
<% end %>	}
<% end %>	k_sem_give(&spc_wake_sem);
}
<% end %>#if defined(SPC_VERIFY)
/* the private (non-cross) states of each entry, for the PRIVATE records */
struct spc_private { uint8_t state; const void *base; uint32_t bytes; };
<% app.scheduled.each do |entry, trig| %>static const struct spc_private spc_private_<%= entry.name %>[] = {
<% entry.params.each do |pn| %><% st = app.state(pn) %><% next if cross.include?(st.name) %>	{ <%= app.states.index(st) %>u, spc_state_<%= st.name %>, <%= st.count * width[st.element] %>u },
<% end %>	{ 255u, 0, 0u }
};
<% end %>static const struct spc_private *spc_privates[] = { <%= app.scheduled.map { |e, _| "spc_private_#{e.name}" }.join(", ") %> };
static inline uint8_t spc_ctx_of(const struct spc_entry *e) { return e->context == 0u ? SPC_CTX_SCHED : SPC_CTX_TIMER; }
/* the last release admitted by the horizon: r with r * period < H */
static inline uint64_t spc_last_admitted(const struct spc_entry *e) { return spc_udiv64(SPC_HORIZON_CYC - 1u, (uint32_t)e->period_cyc); }
#define SPC_REC_SAVE() uint8_t spc_saved_ctx = spc_rec_ctx, spc_saved_entry = spc_rec_entry
#define SPC_REC_SET(ctx, entry) do { spc_rec_ctx = (ctx); spc_rec_entry = (entry); } while (0)
#define SPC_REC_RESTORE() do { spc_rec_ctx = spc_saved_ctx; spc_rec_entry = spc_saved_entry; } while (0)
#endif

/* ---- the failure handler (§4) */
static void spc_safe_state(uint8_t context)
{
<% owned.each do |ctx, list| %>	if (context == <%= ctx == "thread" ? 0 : 1 %>) {
<% list.each do |mod, idx, stem, cls| %><% if mod[:safe] %>		<%= mod[:safe].sub("index", idx.to_s).sub(/\A(\w+)\(/) { "spc_adapter_#{cls}_#{$1}(spc_board_#{stem}_table, " } %>;
<% end %><% end %>	}
<% end %>	(void)context;
}

static void spc_fail(uint32_t entry, int32_t status, uint64_t release)
{
	spc_failed_status = status;
	spc_failed_entry = entry;
	spc_failed_release = release;
<% if failure_sites %>	if (spc_fs_status == 0) {
		spc_fs_site = *spc_fs_sites[entry];
		spc_fs_entry = spc_entries[entry].name;
		spc_fs_status = status;
	}
<% end %>
	spc_context_stopped[spc_entries[entry].context] = 1u;
	spc_safe_state(spc_entries[entry].context);
#if defined(SPC_VERIFY)
	{
		/* the FAIL record, then one CANCEL per entry of the stopped context
		 * for its releases not yet classified (§10), each in that entry's
		 * context and naming the FAIL */
		uint32_t fail_seq;

		spc_tr_FAIL(spc_rec_ctx, spc_rec_entry, status, (uint32_t)release);
		fail_seq = spc_rec_sequence() - 1u;
		for (uint32_t x = 0; x < SPC_ENTRIES; x++) {
			struct spc_entry *xe = &spc_entries[x];
			uint64_t from, to;

			if (xe->context != spc_entries[entry].context) {
				continue;
			}
			from = xe->last_classified + 1u;
			to = spc_last_admitted(xe);
			if (from > to) {
				continue;
			}
			spc_tr_CANCEL(spc_ctx_of(xe), (uint8_t)x, (uint8_t)x, (uint32_t)from, (uint32_t)to, fail_seq);
			xe->last_classified = to;
		}
	}
#endif
	/* no printk here: its frame is Zephyr's, unmeasured, and this runs on
	 * the thread's stack or the timer's; the three words above are the
	 * record, and the verification build's trace reads them */
}

/* ---- selection (§4): one clock reading, the newest pending release */
static void spc_select_and_run(uint32_t i)
{
	struct spc_entry *e = &spc_entries[i];
	uint64_t now = k_cycle_get_64();
	uint64_t newest;
	int32_t status;
<% if bell %>	uint8_t early;
<% end %>
	if (spc_context_stopped[e->context]) {
		return;
	}
#if defined(SPC_VERIFY)
	if (now - spc_epoch >= SPC_HORIZON_CYC) {
		return; /* at H the dispatchers stop selecting; the cuts follow */
	}
	SPC_REC_SAVE();
	SPC_REC_SET(spc_ctx_of(e), (uint8_t)i);
#endif
	newest = spc_udiv64(now - spc_epoch, (uint32_t)e->period_cyc);
<% if bell %>	/* decision 0028: marked due by the doorbell, the entry runs now even when
	 * no release is pending; last_run stays the last periodic release */
	early = spc_due[i] && newest <= e->last_run;
	spc_due[i] = 0u;
	if (newest <= e->last_run && !early) {
<% else %>	if (newest <= e->last_run) {
<% end %>#if defined(SPC_VERIFY)
		spc_tr_SELECT(spc_rec_ctx, spc_rec_entry, now, 0u, 0u, 0u);
		SPC_REC_RESTORE();
#endif
		return;
	}
	/* releases last_run + 1 .. newest - 1 are skipped, never caught up */
#if defined(SPC_VERIFY)
	{
		uint32_t skipped_from = newest - 1u > e->last_run ? (uint32_t)(e->last_run + 1u) : 0u;
		uint32_t skipped_to = skipped_from == 0u ? 0u : (uint32_t)(newest - 1u);

		spc_tr_SELECT(spc_rec_ctx, spc_rec_entry, now, (uint32_t)newest, skipped_from, skipped_to);
		e->last_classified = newest;
		spc_tr_START(spc_rec_ctx, spc_rec_entry, (uint32_t)newest);
	}
#endif
<% if bell %>	if (!early) {
		e->last_run = newest;
	}
<% else %>	e->last_run = newest;
<% end %>#if defined(SPC_VERIFY)
	{
		uint64_t t0 = k_cycle_get_64();

		status = e->run();
		spc_cyc_total[i] += k_cycle_get_64() - t0;
		spc_cyc_calls[i] += 1u;
		spc_tr_STATUS(spc_rec_ctx, spc_rec_entry, status);
	}
#else
	status = e->run();
#endif
	if (status != 0) {
		spc_fail(i, status, newest);
	}
#if defined(SPC_VERIFY)
	for (const struct spc_private *pr = spc_privates[i]; pr->state != 255u; pr++) {
		spc_tr_PRIVATE(spc_rec_ctx, spc_rec_entry, pr->state, (const uint8_t *)pr->base, pr->bytes);
	}
	spc_tr_END(spc_rec_ctx, spc_rec_entry, (uint32_t)newest);
	SPC_REC_RESTORE();
#endif
}

#if defined(SPC_VERIFY)
/* at H: one CUT per unstopped entry of the context, for the releases still
 * pending and never selected (§10) */
static void spc_cut(uint8_t context)
{
	for (uint32_t i = 0; i < SPC_ENTRIES; i++) {
		struct spc_entry *e = &spc_entries[i];
		uint64_t from, to;

		if (e->context != context || spc_context_stopped[context]) {
			continue;
		}
		from = e->last_classified + 1u;
		to = spc_last_admitted(e);
		if (from > to) {
			continue;
		}
		spc_tr_CUT(spc_ctx_of(e), (uint8_t)i, (uint8_t)i, (uint32_t)from, (uint32_t)to);
		e->last_classified = to;
	}
}
#endif

/* ---- the scheduler thread */
/* In the core's data TCM where the board has one (the FRDM-IMXRT1186's
 * zephyr,dtcm): the entries run on this stack, and a board whose RAM is
 * external (zephyr,sram = hyperram0) would otherwise spill to it. The size
 * and the guard are the same either way. */
#if DT_NODE_HAS_STATUS_OKAY(DT_CHOSEN(zephyr_dtcm)) && defined(CONFIG_USERSPACE)
static Z_THREAD_STACK_DEFINE_IN(spc_scheduler_stack, SPC_SCHEDULER_STACK, __dtcm_noinit_section);
#elif DT_NODE_HAS_STATUS_OKAY(DT_CHOSEN(zephyr_dtcm))
/* without CONFIG_USERSPACE, K_THREAD_STACK_DEFINE is K_KERNEL_STACK_DEFINE */
static Z_KERNEL_STACK_DEFINE_IN(spc_scheduler_stack, SPC_SCHEDULER_STACK, __dtcm_noinit_section);
#else
static K_THREAD_STACK_DEFINE(spc_scheduler_stack, SPC_SCHEDULER_STACK);
#endif
/* The requested size, as a word the build's step 10 reads back from the
 * image (0014 §8): the stack object itself is rounded up to the stack
 * alignment, so its size alone cannot tell R from R - 1. Volatile and read
 * by the thread creation below, so nothing folds or garbage-collects it. */
const volatile uint32_t spc_scheduler_stack_size = SPC_SCHEDULER_STACK;
static struct k_thread spc_scheduler_thread_data;

static void spc_scheduler_thread(void *a, void *b, void *c)
{
	(void)a; (void)b; (void)c;
	for (;;) {
		uint64_t next = UINT64_MAX;

#if defined(SPC_VERIFY)
		if (k_cycle_get_64() - spc_epoch >= SPC_HORIZON_CYC) {
			/* the horizon: cut the thread entries, wait for the timer
			 * dispatch's cuts, then ask the transport thread for the end
			 * sequence; D past H makes an incomplete trace say so */
			uint8_t has_isr = 0;

			SPC_REC_SET(SPC_CTX_SCHED, SPC_NO_ENTRY);
<% if nest_timer %>			spc_nest_timer_stop(); /* the nesting source ends with the run */
<% end %>			spc_cut(0u);
			for (uint32_t i = 0; i < SPC_ENTRIES; i++) {
				has_isr |= spc_entries[i].context == 1u;
			}
			while (has_isr && !spc_isr_cut_done) {
				if (k_cycle_get_64() - spc_epoch >= SPC_HORIZON_CYC + SPC_DRAIN_CYC) {
					spc_end_timed_out = 1u; /* D bounds this wait too: the end marker says incomplete */
					break;
				}
				k_msleep(1);
			}
			spc_end_requested = 1u;
			while (!spc_ended) {
				if (k_cycle_get_64() - spc_epoch >= SPC_HORIZON_CYC + SPC_DRAIN_CYC) {
					spc_end_timed_out = 1u;
				}
				k_msleep(1);
			}
			k_sleep(K_FOREVER);
		}
#endif
		for (uint32_t i = 0; i < SPC_ENTRIES; i++) {
			if (spc_entries[i].context == 0u) {
				spc_select_and_run(i);
			}
		}
		for (uint32_t i = 0; i < SPC_ENTRIES; i++) {
			struct spc_entry *e = &spc_entries[i];
			uint64_t t;

			if (e->context != 0u || spc_context_stopped[0]) {
				continue;
			}
			t = spc_epoch + (e->last_run + 1u) * e->period_cyc;
			if (t < next) {
				next = t;
			}
		}
		if (next == UINT64_MAX) {
#if defined(SPC_VERIFY)
			next = spc_epoch + SPC_HORIZON_CYC; /* nothing pending: wake at H for the cuts */
#else
			k_sleep(K_FOREVER);
#endif
		}
#if defined(SPC_VERIFY)
		if (next > spc_epoch + SPC_HORIZON_CYC) {
			next = spc_epoch + SPC_HORIZON_CYC;
		}
#endif
<% if bell %>		/* the next release, or the doorbell first (decision 0028) */
		(void)k_sem_take(&spc_wake_sem, K_TIMEOUT_ABS_TICKS(k_cyc_to_ticks_ceil64(next)));
<% else %>		k_sleep(K_TIMEOUT_ABS_TICKS(k_cyc_to_ticks_ceil64(next)));
<% end %>	}
}

/* ---- timer dispatch: the interrupt entries, from the system clock interrupt */
static struct k_timer spc_timers[SPC_ENTRIES];

static void spc_timer_expiry(struct k_timer *t)
{
	(void)t;
#if defined(SPC_VERIFY)
	{
		SPC_REC_SAVE();
		SPC_REC_SET(SPC_CTX_TIMER, SPC_NO_ENTRY);
		if (k_cycle_get_64() - spc_epoch >= SPC_HORIZON_CYC) {
			if (!spc_isr_cut_done) {
				spc_cut(1u);
				spc_isr_cut_done = 1u;
				for (uint32_t i = 0; i < SPC_ENTRIES; i++) {
					if (spc_entries[i].context == 1u) {
						k_timer_stop(&spc_timers[i]);
					}
				}
			}
			SPC_REC_RESTORE();
			return;
		}
		SPC_REC_RESTORE();
	}
#endif
	for (uint32_t i = 0; i < SPC_ENTRIES; i++) {
		if (spc_entries[i].context == 1u) {
			spc_select_and_run(i);
		}
	}
}

