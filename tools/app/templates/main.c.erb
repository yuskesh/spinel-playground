		       spc_entries[i].name, (unsigned)spc_cyc_calls[i], (unsigned long long)spc_cyc_total[i],
		       (unsigned)spc_cyc_ldivmod_calls[i], (unsigned long long)spc_cyc_ldivmod[i]);
	}
	{
