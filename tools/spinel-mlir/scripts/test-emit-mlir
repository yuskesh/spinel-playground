#!/bin/bash
set -eu
compiler=$1
input=$2
output=$3
"$compiler" "--emit-mlir=$output" "$input" >"$output.stdout" 2>"$output.stderr"
test ! -s "$output.stdout"
rg -q 'spinel_facts.status = "success"' "$output"
rg -q '^  \}\) \{phase = "pristine"' "$output"
rg -q '^  \}\) \{phase = "analyzed"' "$output"
rg -q 'spinel_facts.refusal_checked = true' "$output"
