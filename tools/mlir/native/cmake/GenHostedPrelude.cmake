# GenHostedPrelude.cmake -- the Extended hosted prelude (decision 0042 stage 4)
# as a C++ string.
#
# tools/core/hosted-prelude.rb is the one copy. The core checker, the core
# emitter and the freestanding emitter append its definitions to the copy of
# a source they hand the contract reader, and tools/core/spinel-core-build
# appends them to the copy the hosted compiler reads, after checking that
# the emitter's embedded copy is the file it snapshotted. Generated at
# configure time, and configure is rerun when the file changes; the binaries
# never read the file.
#
# Output: ${CMAKE_BINARY_DIR}/include/spinel-mlir/Core/HostedPrelude.inc
function(spinel_generate_hosted_prelude rb out)
  file(READ "${rb}" _text)
  string(FIND "${_text}" ")SPINEL_PRELUDE" _clash)
  if(NOT _clash EQUAL -1)
    message(FATAL_ERROR "${rb} contains the raw string's delimiter )SPINEL_PRELUDE")
  endif()
  set(_body "// Generated by cmake/GenHostedPrelude.cmake from tools/core/hosted-prelude.rb.\n")
  string(APPEND _body "// Do not edit; edit the .rb file.\n")
  string(APPEND _body "static constexpr llvm::StringLiteral kHostedPrelude = R\"SPINEL_PRELUDE(${_text})SPINEL_PRELUDE\";\n")
  file(WRITE "${out}" "${_body}")
  set_property(DIRECTORY ${CMAKE_SOURCE_DIR} APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${rb}")
  message(STATUS "spinel-mlir: hosted prelude -> ${out}")
endfunction()
