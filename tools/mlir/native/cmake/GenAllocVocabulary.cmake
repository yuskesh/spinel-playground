# Generate the allocation-vocabulary C++ header.
# tools/realtime/alloc_vocabulary.tsv is the sole canonical vocabulary for
# native spinel-rtcheck and UndefGate.cpp, preventing their sets from diverging.
# Generation happens during configuration: binaries do not read this file at
# runtime, so users can run the undefined-symbol gate with build/bin alone.
#
# Generated file: ${CMAKE_BINARY_DIR}/include/spinel-mlir/Realtime/AllocVocabulary.inc
function(spinel_generate_alloc_vocabulary tsv out)
  file(STRINGS "${tsv}" _lines ENCODING UTF-8)
  set(_alloc "") 
  set(_pause "")
  set(_abort "")
  set(_setjmp "")
  set(_ctor "")
  set(_allow "")
  set(_allow_prefix "")
  set(_allow_regex "")
  set(_reasons "")
  foreach(_l IN LISTS _lines)
    if(_l MATCHES "^#" OR _l STREQUAL "" OR _l MATCHES "^set\t")
      continue()
    endif()
    string(REPLACE "\t" ";" _f "${_l}")
    list(GET _f 0 _set)
    list(GET _f 1 _name)
    list(LENGTH _f _n)
    set(_reason "-")
    if(_n GREATER 2)
      list(GET _f 2 _reason)
    endif()
    string(REPLACE "\"" "\\\"" _name "${_name}")
    string(REPLACE "\"" "\\\"" _reason "${_reason}")
    if(_set STREQUAL "alloc")
      list(APPEND _alloc "  \"${_name}\"")
      list(APPEND _reasons "  {\"${_name}\", \"${_reason}\"}")
    elseif(_set STREQUAL "pause")
      list(APPEND _pause "  \"${_name}\"")
    elseif(_set STREQUAL "abort_hint")
      list(APPEND _abort "  \"${_name}\"")
    elseif(_set STREQUAL "setjmp")
      list(APPEND _setjmp "  \"${_name}\"")
    elseif(_set STREQUAL "constructor")
      list(APPEND _ctor "  \"${_name}\"")
    elseif(_set STREQUAL "allow")
      list(APPEND _allow "  \"${_name}\"")
    elseif(_set STREQUAL "allow_prefix")
      list(APPEND _allow_prefix "  \"${_name}\"")
    elseif(_set STREQUAL "allow_regex")
      list(APPEND _allow_regex "  \"${_name}\"")
    else()
      message(FATAL_ERROR "alloc_vocabulary.tsv: unknown set '${_set}'")
    endif()
  endforeach()
  # Never silently emit an empty set: a malformed TSV would make both gates
  # report that nothing allocates.
  foreach(_v _alloc _pause _abort _setjmp _ctor _allow _allow_prefix _allow_regex)
    if(NOT ${_v})
      message(FATAL_ERROR "alloc_vocabulary.tsv: ${_v} is empty")
    endif()
  endforeach()
  set(_body "// Generated by cmake/GenAllocVocabulary.cmake; do not edit.\n")
  string(APPEND _body "// Source: tools/realtime/alloc_vocabulary.tsv.\n")
  string(APPEND _body "// clang-format off\n")
  macro(_emit_array _name _var)
    string(JOIN ",\n" _joined ${${_var}})
    string(APPEND _body "static const llvm::StringRef ${_name}[] = {\n${_joined}};\n")
  endmacro()
  _emit_array(kVocabAlloc _alloc)
  _emit_array(kVocabPause _pause)
  _emit_array(kVocabAbortHint _abort)
  _emit_array(kVocabSetjmp _setjmp)
  _emit_array(kVocabConstructor _ctor)
  _emit_array(kVocabAllow _allow)
  _emit_array(kVocabAllowPrefix _allow_prefix)
  _emit_array(kVocabAllowRegex _allow_regex)
  string(JOIN ",\n" _joined_reasons ${_reasons})
  string(APPEND _body "static const struct { llvm::StringRef name; llvm::StringRef reason; } kVocabAllocReason[] = {\n${_joined_reasons}};\n")
  string(APPEND _body "// clang-format on\n")
  file(WRITE "${out}" "${_body}")
  message(STATUS "spinel-mlir: alloc vocabulary -> ${out}")
endfunction()
