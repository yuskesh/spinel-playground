  "spinel-fs-emit" => { "-o" => :file, "--emit-llvm" => :file, "--emit-header" => :file,
                        "--emit-mlir" => :file, "--emit-undef-tsv" => :file },
  "spinel-fs-grad" => { "-o" => :dir, "--out" => :dir, "--emit-header" => :file },
  "spinel-core-boundary" => { "--header" => :file },
