require_relative "../oracle/gate"

ROOT = File.expand_path("../..", __dir__)
SELF = File.expand_path(__FILE__)
BIN = "tools/mlir/native/build/bin"
TOOLS = %w[spinel-core-kernel spinel-core-emit spinel-fs-emit spinel-fs-grad
           spinel-core-boundary spinel-core-adapter spinel-core-package spinel-core-check
           spinel-core-stack].freeze
# The environment variable through which the suites take each tool, where one
# names it alone (SPINEL_CORE_BUILD names them all, as WORK/build).
TOOL_ENV = { "KERNEL" => "spinel-core-kernel", "BOUNDARY" => "spinel-core-boundary",
             "ADAPTER" => "spinel-core-adapter", "PACKAGE" => "spinel-core-package",
             "CORE_CHECK" => "spinel-core-check", "STACK_TOOL" => "spinel-core-stack" }.freeze
BASELINE = File.join(ROOT, "tests/compare-lowering/counts.tsv")
