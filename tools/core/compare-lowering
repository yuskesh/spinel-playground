# DOOM's three entries, packed and built as tests/doom-core/harness/
# artifacts.sh builds them for this host and as tests/doom-core/rt1186.sh
# builds them for the Cortex-M7, through the wrapped kernel.
def doom_entries(dir)
  kernel = ENV.fetch("KERNEL")
  reader = ENV.fetch("SPINEL_TYPEDUMP")
  clang = ENV["CLANG"] || File.join(ENV.fetch("LLVM_PREFIX"), "bin", "clang")
  core = File.join(ROOT, "examples/doom/core")
  entries = %w[doom_core_input doom_core_step doom_core_render]
  FileUtils.mkdir_p(File.join(dir, "unit"))
  File.readlines(File.join(core, "entries/units.tsv")).each do |l|
    next if l.start_with?("#") || l.strip.empty?
    FileUtils.cp(File.join(core, "src", l.split("\t")[0].strip), File.join(dir, "unit"))
  end
  FileUtils.cp(File.join(core, "entries/units.tsv"), File.join(dir, "manifest.tsv"))
  ok = true
  entries.each do |e|
    st = File.join(dir, "stage", e)
    FileUtils.mkdir_p(File.join(st, "src"))
    ok &&= system(RbConfig.ruby, File.join(ROOT, "tools/doom/pack-core.rb"), "--manifest", File.join(dir, "manifest.tsv"),
                  "--root", File.join(dir, "unit"), "--reader", reader, "--entry", e,
                  "--output", File.join(st, "src/packed.rb"), "--map", File.join(st, "map.tsv"))
    FileUtils.cp(File.join(core, "entries", "#{e}.contract"), st)
  end
  return 1 unless ok
  m7 = %w[--target=thumbv7em-none-eabi -mcpu=cortex-m7 -mfloat-abi=soft -mthumb -Os -ffreestanding]
  allow = File.join(ROOT, "tools/core/int64-allow.tsv")
  # three at a time, as rt1186.sh builds them: the host builds, then the M7's
  builds = entries.flat_map do |e|
    st = File.join(dir, "stage", e)
    host = File.join(dir, "host")
    m7d = File.join(dir, "cm7")
    FileUtils.mkdir_p([host, m7d])
    [[kernel, "#{st}/#{e}.contract", "--root", st, "--typedump", reader, "--int64-allow", allow,
      "-o", "#{host}/#{e}.o", "--header", "#{host}/#{e}.h", "--clang", clang],
     [kernel, "#{st}/#{e}.contract", "--root", st, "--typedump", reader, "-o", "#{m7d}/#{e}.o",
      "--header", "#{m7d}/#{e}.h", "--layout", "ptr32-i64-32long", "--report", "#{m7d}/report_#{e}.json",
      "--profile", "hosted-stage2", "--clang", clang, "--", *m7]]
  end
  results = [builds.select.with_index { |_, i| i.even? }, builds.select.with_index { |_, i| i.odd? }].flat_map do |group|
    group.map { |cmd| Thread.new { system(*cmd, out: File::NULL) } }.map(&:value)
  end
  puts "doom-entries: #{results.count(true)} of #{results.size} builds exit 0"
  results.all? ? 0 : 1
end

# --counts: a file, `none` (the counts are written and not checked: only to
# make a new baseline), or by default the tracked baseline.
def counts_option(arg)
  return nil if arg == "none"
  path = File.expand_path(arg || BASELINE)
  File.file?(path) or die("no counts baseline at #{path}")
  path
end

# The gated sections tests/ORACLES.tsv lists, as [path, section].
def oracle_sections
  File.readlines(File.join(ROOT, "tests/ORACLES.tsv")).filter_map do |l|
    next if l.start_with?("#") || l.strip.empty?
    f = l.chomp.split("\t")
    [f[0], f[1]]
  end
end

# The skips the suites declare (SKIPS): [route, lane, the start of the reason].
def declared_skips
  File.readlines(SKIPS).filter_map do |l|
    next if l.start_with?("#") || l.strip.empty?
    l.chomp.split("\t", 3)
  end
end

# What a route's log says about checks that did not run: [known, bad], each a
# list of "route lane: text". A tool built from other source than the tree's
# is always bad; a gated oracle section is known when tests/ORACLES.tsv lists
# it; any other lane that could not run, and any skip, is known only when
# SKIPS names it. A summary that counts more skips, or more lanes that could
# not run, than the log names is bad as well, so nothing is passed by count.
def scan_route_log(route, log, suite)
  known = []
  bad = []
  oracles = oracle_sections
  skips = declared_skips
  named = Hash.new(0)
  counted = Hash.new(0)
  judge = lambda do |lane, text, line|
    if text.include?("built from other source")
      bad << "STALE #{route} #{lane}: #{text}"
    elsif skips.any? { |r, l, why| r == route && l == lane && text.start_with?(why) }
      known << "#{route} #{lane}: #{text}"
    else
      bad << "NOT-RUN #{route} #{lane}: #{line.strip}"
    end
  end
  File.foreach(log) do |line|
    line = line.chomp
    case line
    when /NOT RUN \(oracle\): (\S+) (\S+?): (.*)/
      if oracles.include?([$1, $2]) then known << "#{route} oracle #{$1} #{$2}"
      else bad << "NOT-RUN #{route} oracle: #{line.strip}"
      end
    when /^\s*NOT RUN\s{2,}(\S+): (.*)/ # a core-boundary lane that could not start
      named[:notrun] += 1
      judge.call($1, $2, line)
    when /^\s*SKIP\s{2,}(\S+): (.*)/ # a core-boundary lane's named skip
      named[:skip] += 1
      judge.call($1, $2, line)
    when /^\s*SKIP (.*)/
      named[:skip] += 1
      judge.call(suite, $1, line)
    when /^(\S+): .*NOT RUN: (.*?)(?: \[[^\]]*\])?$/ # a freestanding lane
      judge.call($1, $2, line)
    when /built from other source/ # a suite with no lanes, refusing a tool
      bad << "STALE #{route} #{suite}: #{line.strip}"
    when /NOT RUN/
      bad << "NOT-RUN #{route} #{suite}: #{line.strip}"
    end
    counted[:skip] += $1.to_i if line =~ /\b(\d+) skipped\b/
    counted[:notrun] += $1.to_i if line =~ /\b(\d+) could not run\b/
  end
  { skip: "skip(s)", notrun: "lane(s) that could not run" }.each do |k, what|
    next if counted[k] <= named[k]
    bad << "NOT-RUN #{route} #{suite}: the log counts #{counted[k]} #{what} and names #{named[k]}"
  end
  [known, bad]
end

def summarize(work, counts_file)
  rows = File.exist?(File.join(work, "calls.tsv")) ? File.readlines(File.join(work, "calls.tsv")).map { |l| l.chomp.split("\t") } : []
  routes_ran = File.exist?(File.join(work, "routes.tsv")) ? File.readlines(File.join(work, "routes.tsv")).map { |l| l.chomp.split("\t") } : []
  counts = Hash.new(0)
  rows.each { |r| counts[[r[0], r[1]]] += 1 }
  File.write(File.join(work, "counts.tsv"),
             "#route\ttool\tcalls\n" + counts.sort.map { |(r, t), n| "#{r}\t#{t}\t#{n}\n" }.join)
  bad = 0
  known = []
  puts "== routes"
  routes_ran.each do |name, rc, secs|
    calls = rows.count { |r| r[0] == name }
    per = TOOLS.filter_map { |t| "#{t.sub('spinel-', '')} #{counts[[name, t]]}" if counts[[name, t]].positive? }.join(", ")
    puts "  #{name}: suite exit #{rc}, #{secs} s, #{calls} call(s): #{per}"
    if calls.zero?
      puts "    FAIL #{name} called none of the wrapped tools"
      bad += 1
    end
    log = File.join(work, "routes", "#{name}.log")
    next unless File.file?(log)
    # A line no lane claims is the suite's own: name it by its script.
    argv = routes(work)[name] || []
    suite = argv[0] == "sh" && argv[1].to_s.end_with?(".sh") ? argv[1].delete_prefix("#{ROOT}/") : name
    k, b = scan_route_log(name, log, suite)
    known.concat(k)
    b.each { |m| puts "    #{m}" }
    bad += b.size
  end
  puts "== skips the suites declare (#{known.size}), by name"
  known.each { |m| puts "  #{m}" }
  verdicts = Hash.new(0)
  rows.each { |r| verdicts[r[2].split.first] += 1 }
  puts "== calls: #{rows.size}; " + verdicts.sort.map { |v, n| "#{v} #{n}" }.join(", ")
  TOOLS.each { |t| puts "  #{t}: #{rows.count { |r| r[1] == t }}" }
  rows.each do |r|
    next unless r[2].start_with?("DIFF", "EMPTY")
    puts "  #{r[2].split.first} #{r[0]} #{r[1]}: #{r[2].split(' ', 2)[1]} (#{r[5]})"
    bad += 1
  end
  if counts_file
    base = Hash.new(0)
    File.readlines(counts_file).each do |l|
      next if l.start_with?("#") || l.strip.empty?
      r, t, n = l.chomp.split("\t")
      base[[r, t]] = n.to_i
    end
    keys = (base.keys | counts.keys).select { |r, _| routes_ran.any? { |x| x[0] == r } }
    keys.sort.each do |k|
      next if base[k] == counts[k]
      puts "  COUNT #{k[0]} #{k[1]}: #{counts[k]} call(s), #{base[k]} in #{counts_file}"
      bad += 1
    end
    puts "== counts: checked against #{counts_file}"
  else
    puts "== counts: NOT CHECKED (--counts none); WORK/counts.tsv is a candidate baseline"
  end
  puts "compare-lowering: #{bad.zero? ? 'no difference' : "#{bad} failure(s)"}"
  bad.zero? ? 0 : 1
end

def run(argv)
  old = new = work = perturb = counts = nil
  only = []
  until argv.empty?
    case (a = argv.shift)
    when "--old" then old = File.expand_path(argv.shift)
    when "--new" then new = File.expand_path(argv.shift)
    when "--work" then work = File.expand_path(argv.shift)
    when "--route" then only << argv.shift
    when "--perturb" then perturb = argv.shift
    when "--counts" then counts = argv.shift
    else die("run: unknown argument #{a}")
    end
  end
  old && new && work or die("usage: compare-lowering run --old DIR --new DIR --work DIR [--route NAME]... [--perturb object|mlir|text] [--counts FILE|none]")
  counts = counts_option(counts)
  die("run: --perturb is object, mlir or text") if perturb && !%w[object mlir text].include?(perturb)
  exit 0 unless OracleGate.allow?("tools/core/compare-lowering", "whole")
  ENV.delete("ALLOW_ORACLE")
  verify_frozen(old)
  verify_frozen(new)
  File.executable?(MLIR_OPT) or die("no mlir-opt at #{MLIR_OPT}; set LLVM_PREFIX")
  die("run: #{work} exists") if File.exist?(work)
  all = routes(work)
  unknown = only - all.keys
  die("run: unknown route(s) #{unknown.join(', ')}") unless unknown.empty?
  bin = File.join(work, "build", "bin")
  FileUtils.mkdir_p(bin)
  old = make_arm(File.join(work, "arms", "old"), old)
  new = make_arm(File.join(work, "arms", "new"), new)
  File.write(File.join(work, "config.json"), JSON.generate("old" => old, "new" => new, "perturb" => perturb))
  Dir.children(File.join(new, BIN)).each do |f|
    if TOOLS.include?(f)
      File.write(File.join(bin, f), "#!/bin/sh\nCL_STATE=#{work.shellescape} exec #{RbConfig.ruby.shellescape} " \
                                    "#{SELF.shellescape} exec #{f} \"$@\"\n")
      File.chmod(0o755, File.join(bin, f))
    elsif f == "source-stamp.tsv"
      FileUtils.cp(File.join(new, BIN, f), bin)
    else
      File.symlink(File.join(new, BIN, f), File.join(bin, f))
    end
  end
  env = TOOL_ENV.transform_values { |t| File.join(bin, t) }.merge(
    "SPINEL_CORE_BUILD" => File.join(work, "build"),
    "SPINEL_TYPEDUMP" => File.join(new, "tools/contract/build/spinel-typedump"),
    "FS_WORK" => File.join(work, "fs")
  )
  FileUtils.mkdir_p(File.join(work, "routes"))
  (only.empty? ? all.keys : only).each do |name|
    t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    log = File.join(work, "routes", "#{name}.log")
    ok = system(env.merge("CL_ROUTE" => name), *all[name], chdir: ROOT, out: log, err: %i[child out])
    rc = ok ? 0 : ($?.exitstatus || 1)
    secs = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0).round
    File.open(File.join(work, "routes.tsv"), "a") { |f| f.puts([name, rc, secs].join("\t")) }
    puts "compare-lowering: #{name}: suite exit #{rc}, #{secs} s"
  end
  exit summarize(work, counts)
end

case ARGV.shift
when "freeze" then freeze(ARGV)
when "run" then run(ARGV)
when "report"
  work = counts = nil
  until ARGV.empty?
    case (a = ARGV.shift)
    when "--work" then work = File.expand_path(ARGV.shift)
    when "--counts" then counts = ARGV.shift
    else die("report: unknown argument #{a}")
    end
  end
  work or die("usage: compare-lowering report --work DIR [--counts FILE|none]")
  exit summarize(work, counts_option(counts))
when "exec"
  state = ENV.fetch("CL_STATE") { die("exec runs only under its wrapper") }
  tool = ARGV.shift
  TOOLS.include?(tool) or die("exec: unknown tool #{tool}")
  exit Call.new(state, tool, ARGV).run
when "doom-entries"
  exit doom_entries(ARGV.fetch(0))
else
  die("usage: compare-lowering freeze|run|report ...; see the header")
end
