MLIR_OPT = File.join(ENV.fetch("LLVM_PREFIX", "/opt/llvm-23.1.1"), "bin", "mlir-opt")

def die(msg, code = 2)
  warn "compare-lowering: #{msg}"
  exit code
end

def sha_list(dir)
  Dir.glob("**/*", File::FNM_DOTMATCH, base: dir).sort.filter_map do |rel|
    path = File.join(dir, rel)
    next if !File.file?(path) || File.symlink?(path) || rel == "SHA256SUMS"
    "#{Digest::SHA256.file(path).hexdigest}  #{rel}\n"
  end.join
end

# ---- freeze --------------------------------------------------------------

def freeze(argv)
  tree = to = nil
  until argv.empty?
    case (a = argv.shift)
    when "--tree" then tree = argv.shift
    when "--to" then to = argv.shift
    else die("freeze: unknown argument #{a}")
    end
  end
  tree && to or die("usage: compare-lowering freeze --tree TREE --to DIR")
  tree = File.expand_path(tree)
  to = File.expand_path(to)
  die("freeze: #{to} exists") if File.exist?(to)
  die("freeze: #{to} is inside the tree") if to.start_with?(tree + "/")
  copies = Dir.children(File.join(tree, BIN)).sort.map { |f| File.join(BIN, f) } +
           ["tools/contract/build/spinel-typedump", "tools/contract/build/source-stamp.tsv"]
  copies.each do |rel|
    src = File.join(tree, rel)
    next unless File.file?(src)
    FileUtils.mkdir_p(File.dirname(File.join(to, rel)))
    FileUtils.cp(src, File.join(to, rel), preserve: true)
  end
  TOOLS.each { |t| File.executable?(File.join(to, BIN, t)) or die("freeze: no #{t} in #{tree}/#{BIN}") }
  rev = `git -C #{Shellwords.escape(tree)} rev-parse HEAD`.strip
  dirty = `git -C #{Shellwords.escape(tree)} status --porcelain -- tools/mlir/native`.lines.size
  File.write(File.join(to, "FROZEN"), "tree #{tree}\nrevision #{rev}\nuncommitted under tools/mlir/native: #{dirty}\n")
  File.write(File.join(to, "SHA256SUMS"), sha_list(to))
  puts "compare-lowering: froze #{copies.size} file(s) of #{tree} (#{rev[0, 12]}, #{dirty} uncommitted) at #{to}"
end

# WORK/arms/ARM: this checkout, with the frozen files of `frozen` in place of
# its own. A directory on the way to a frozen file is real, everything else a
# link.
def make_arm(dst, frozen)
  files = File.readlines(File.join(frozen, "SHA256SUMS")).map { |l| l.chomp.split("  ", 2)[1] } - ["FROZEN"]
  dirs = files.flat_map { |f| d = File.dirname(f); a = []; (a << d; d = File.dirname(d)) while d != "."; a }.uniq
  fill = lambda do |rel|
    here = rel.empty? ? dst : File.join(dst, rel)
    FileUtils.mkdir_p(here)
    src = rel.empty? ? ROOT : File.join(ROOT, rel)
    names = File.directory?(src) ? Dir.children(src) : []
    (files + dirs).each do |p|
      next unless rel.empty? || p.start_with?("#{rel}/")
      names << (rel.empty? ? p : p.delete_prefix("#{rel}/")).split("/").first
    end
    names.uniq.each do |c|
      r = rel.empty? ? c : File.join(rel, c)
      if files.include?(r) then FileUtils.cp(File.join(frozen, r), File.join(here, c), preserve: true)
      elsif dirs.include?(r) then fill.call(r)
      else File.symlink(File.join(src, c), File.join(here, c))
      end
    end
  end
  fill.call("")
  sums = files.map { |r| "#{Digest::SHA256.file(File.join(dst, r)).hexdigest}  #{r}\n" }.sort.join
  want = File.readlines(File.join(frozen, "SHA256SUMS")).reject { |l| l.end_with?("  FROZEN\n") }.sort.join
  sums == want or die("#{dst}: the copied files do not match #{frozen}/SHA256SUMS")
  dst
end

def verify_frozen(dir)
  sums = File.join(dir, "SHA256SUMS")
  File.file?(sums) or die("#{dir} has no SHA256SUMS; freeze it first")
  File.read(sums) == sha_list(dir) or die("#{dir} no longer matches its SHA256SUMS")
end

# ---- exec: one wrapped call -----------------------------------------------

def binary?(bytes)
  bytes.include?("\0")
end

# The MLIR in generic form, with the locations mlir-opt took from the file it
# parsed removed. nil when mlir-opt cannot read it; the raw text then stands.
def generic_mlir(path)
  out, err, st = Open3.capture3(MLIR_OPT, "--allow-unregistered-dialect", "--mlir-print-op-generic",
                                "--mlir-print-debuginfo", "--mlir-print-local-scope", path)
  return [nil, err] unless st.success?
  [out.gsub(/loc\(#{Regexp.escape(path.inspect)}:\d+:\d+\)/, "loc(implicit)"), nil]
end

class Call
  attr_reader :tool, :args, :dir

  def initialize(state, tool, args)
    @state = state
    @config = JSON.parse(File.read(File.join(state, "config.json")))
    @tool = tool
    @args = args
    FileUtils.mkdir_p(File.join(state, "calls"))
    @dir = Dir.mktmpdir("#{tool}-", File.join(state, "calls"))
    @outputs = find_outputs
  end

  # [index of the value, kind] for each output argument, before any `--`.
  def find_outputs
    spec = OUTPUTS.fetch(@tool)
    found = []
    i = 0
    while i < @args.size
      break if @args[i] == "--"
      if (kind = spec[@args[i]]) && i + 1 < @args.size
        found << [i + 1, kind]
        i += 2
      else
        i += 1
      end
    end
    found
  end

  def wants_mlir?
    return false if @outputs.any? { |i, _| @args[i - 1] == "--emit-mlir" }
    case @tool
    when "spinel-core-kernel", "spinel-core-emit" then true
    when "spinel-fs-emit" then !%w[--probe --admit].include?(@args[0]) && @args[1] != "--freestanding"
    else false
    end
  end

  def arm_argv(arm)
    argv = @args.dup
    @outputs.each_with_index do |(i, kind), k|
      d = File.join(@dir, arm, "out#{k}")
      FileUtils.mkdir_p(d)
      base = File.basename(@args[i])
      base = "null" if @args[i] == "/dev/null"
      argv[i] = File.join(d, base)
      FileUtils.mkdir_p(argv[i]) if kind == :dir && File.directory?(@args[i])
    end
    if wants_mlir?
      extra = ["--emit-mlir", File.join(@dir, arm, "forced.mlir")]
      at = argv.index("--") || argv.size
      argv.insert(at, *extra)
    end
    argv
  end

  def run_arm(arm)
    root = @config.fetch(arm)
    argv = arm_argv(arm)
    exe = File.join(root, BIN, @tool)
    out, err, st = Open3.capture3(exe, *argv, stdin_data: "")
    { argv: argv, out: out, err: err, rc: st.exitstatus || 128 + st.termsig.to_i, root: root,
      digest: Digest::SHA256.file(exe).hexdigest }
  end

  # Text as the call named it: the arm's output directory read as the named
  # path, the arm's install root as <TOOLS>, and the digest of the arm's own
  # tool (the kernel's report records it) as <TOOL-SHA256>.
  def plain(text, arm, run)
    s = text.dup
    @outputs.each { |i, _| s = s.gsub(run[:argv][i], @args[i]) }
    s = s.gsub(File.join(@dir, arm), "<CALL>")
    s = s.gsub(run[:root], "<TOOLS>").gsub(run[:digest], "<TOOL-SHA256>")
    # a tool's own temporary directory, a path component `spinel-<tool>-` (or
    # `.spinel-inputs.`) and six random characters
    s.gsub(%r{(?<=/)(\.?spinel-[a-z0-9-]+?)([-.])[0-9A-Za-z]{6}(?=/|$)}, "\\1\\2XXXXXX")
  end

  def perturb(run)
    case @config["perturb"]
    when "object"
      i, = @outputs.find { |j, k| k == :file && @args[j - 1] == "-o" && File.size?(run[:argv][j]) }
      flip(run[:argv][i]) if i
    when "mlir"
      m = @outputs.find { |j, _| @args[j - 1] == "--emit-mlir" }
      path = m ? run[:argv][m[0]] : File.join(@dir, "new", "forced.mlir")
      flip(path, text: true) if File.size?(path)
    when "text"
      run[:err] += "x"
    end
  end

  # One byte changed. In MLIR, the last letter of a function name the module
  # names only once (its definition), so the file still parses and verifies;
  # elsewhere the middle byte.
  def flip(path, text: false)
    b = File.binread(path)
    at = b.size / 2
    if text
      names = b.scan(/func\.func (?:private )?@([A-Za-z_][A-Za-z0-9_]*)/).flatten
      name = names.reverse.find { |x| b.scan(/@#{x}\b/).size == 1 }
      at = b.index(/@#{name}\b/) + name.size if name
    end
    b.setbyte(at, text ? (b[at] == "x" ? "y" : "x").ord : b.getbyte(at) ^ 1)
    File.binwrite(path, b)
  end

  def compare(old, new)
    diffs = []
    diffs << "status (#{old[:rc]} vs #{new[:rc]})" if old[:rc] != new[:rc]
    diffs << "stdout" if plain(old[:out], "old", old) != plain(new[:out], "new", new)
    diffs << "stderr" if plain(old[:err], "old", old) != plain(new[:err], "new", new)
    empty = []
    @outputs.each do |i, kind|
      a = old[:argv][i]
      b = new[:argv][i]
      name = "#{@args[i - 1]} #{File.basename(@args[i])}"
      if kind == :dir
        fa = File.directory?(a) ? Dir.glob("**/*", base: a).sort : nil
        fb = File.directory?(b) ? Dir.glob("**/*", base: b).sort : nil
        if fa != fb then diffs << "#{name}: the files differ"
        elsif fa
          fa.each do |f|
            next unless File.file?(File.join(a, f))
            diffs << "#{name}/#{f}" unless same_file(File.join(a, f), File.join(b, f), old, new)
          end
          empty << name if new[:rc].zero? && fa.empty?
        end
        next
      end
      ea = File.exist?(a)
      eb = File.exist?(b)
      if ea != eb then diffs << "#{name}: written by one arm only"
      elsif ea
        diffs << name unless same_file(a, b, old, new)
        empty << name if new[:rc].zero? && @args[i] != "/dev/null" && File.size(b).zero?
      elsif new[:rc].zero? && @args[i] != "/dev/null"
        empty << "#{name}: not written"
      end
    end
    mlirs = @outputs.filter_map { |i, _| [old[:argv][i], new[:argv][i]] if @args[i - 1] == "--emit-mlir" }
    mlirs << [File.join(@dir, "old", "forced.mlir"), File.join(@dir, "new", "forced.mlir")] if wants_mlir?
    mlirs.each do |a, b|
      next unless File.exist?(a) || File.exist?(b)
      next diffs << "mlir: written by one arm only" unless File.exist?(a) && File.exist?(b)
      ga, ea = generic_mlir(a)
      gb, eb = generic_mlir(b)
      if ga && gb
        diffs << "mlir (generic)" if ga != gb
      elsif ga || gb
        File.write(File.join(@dir, "mlir-opt.err"), "old:\n#{ea}new:\n#{eb}")
        diffs << "mlir (mlir-opt read one arm only)"
      else
        File.write(File.join(@dir, "mlir-opt.err"), "old:\n#{ea}new:\n#{eb}")
        diffs << "mlir (raw; mlir-opt could not read it)" if File.binread(a) != File.binread(b)
      end
    end
    return "DIFF #{diffs.join('; ')}" unless diffs.empty?
    return "same-refusal" unless new[:rc].zero?
    empty << "no output file and no output" if @outputs.empty? && new[:out].empty? && new[:err].empty?
    return "EMPTY #{empty.join('; ')}" unless empty.empty?
    "same"
  end

  def same_file(a, b, old, new)
    x = File.binread(a)
    y = File.binread(b)
    return x == y if binary?(x) || binary?(y)
    plain(x, "old", old) == plain(y, "new", new)
  end

  # The new arm's outputs where the call named them, and its status.
  def hand_back(new)
    @outputs.each do |i, kind|
      dst = @args[i]
      src = new[:argv][i]
      next if dst == "/dev/null" || !File.exist?(src)
      if kind == :dir
        FileUtils.mkdir_p(dst)
        FileUtils.cp_r(File.join(src, "."), dst)
      else
        FileUtils.cp(src, dst)
      end
    end
    # a line naming the MLIR this added is not the call's to see
    forced = File.join(@dir, "new", "forced.mlir")
    out = new[:out].lines.reject { |l| l.include?(forced) }.join
    err = new[:err].lines.reject { |l| l.include?(forced) }.join
    @outputs.each do |i, _|
      out = out.gsub(new[:argv][i], @args[i])
      err = err.gsub(new[:argv][i], @args[i])
    end
    $stdout.write(out)
    $stderr.write(err)
    new[:rc]
  end

  def run
    old = run_arm("old")
    new = run_arm("new")
    perturb(new) if @config["perturb"]
    verdict = compare(old, new)
    File.write(File.join(@dir, "argv"), ([@tool] + @args).shelljoin + "\n")
    { "old" => old, "new" => new }.each do |arm, r|
      File.write(File.join(@dir, "#{arm}.stdout"), r[:out])
      File.write(File.join(@dir, "#{arm}.stderr"), r[:err])
    end
    row = [ENV.fetch("CL_ROUTE", "-"), @tool, verdict, old[:rc], new[:rc],
           @dir.delete_prefix(@state + "/")].join("\t") + "\n"
    File.open(File.join(@state, "calls.tsv"), "a") do |f|
      f.flock(File::LOCK_EX)
      f.write(row)
    end
    hand_back(new)
  end
end

# ---- run -----------------------------------------------------------------

def routes(work)
  tests = File.join(ROOT, "tests")
  {
