# The arguments that name an output, per tool: a file, or a directory.
OUTPUTS = {
  "spinel-core-kernel" => { "-o" => :file, "--header" => :file, "--extern-header" => :file,
                            "--emit-mlir" => :file, "--emit-optimised-ir" => :file,
                            "--failure-sites" => :file, "--report" => :file },
  "spinel-core-emit" => { "-o" => :file, "--emit-mlir" => :file, "--inputs-out" => :file,
